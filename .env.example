# RefCheck Environment Configuration
# Copy this to .env file in the project root

# Database Configuration
# Primary database selection - OpenAlex recommended for speed and coverage
ENABLED_DATABASES=openalex,semantic_scholar,dblp,iacr,arxiv,pubmed
PRIMARY_DATABASE=openalex

# OpenAlex Configuration (Recommended - fast, free, comprehensive)
OPENALEX_ENABLED=true
OPENALEX_EMAIL=your.email@domain.com  # Optional - polite identifier

# API Configuration
SEMANTIC_SCHOLAR_API_KEY=your_api_key_here
SEMANTIC_SCHOLAR_TIMEOUT=30
SEMANTIC_SCHOLAR_MAX_RETRIES=3
SEMANTIC_SCHOLAR_RATE_LIMIT=1.0

# CrossRef Configuration (Optional fallback - disabled by default)
# CrossRef API requires a valid email address for polite access
CROSSREF_EMAIL=your.email@domain.com
CROSSREF_ENABLED=false  # Disabled by default - enable only if needed

# DBLP Configuration
DBLP_ENABLED=true

# IACR Configuration  
IACR_ENABLED=true

# ArXiv Configuration
ARXIV_ENABLED=true

# PubMed Configuration
PUBMED_ENABLED=true
NCBI_API_KEY=your_ncbi_api_key_here  # Optional but recommended
NCBI_EMAIL=your.email@domain.com

# Classification Thresholds (current optimized values)
SIMILARITY_THRESHOLD=0.45
TITLE_WEIGHT=0.60
AUTHOR_WEIGHT=0.20
VENUE_WEIGHT=0.15
YEAR_WEIGHT=0.05
MAX_YEAR_DIFFERENCE=3
