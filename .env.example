# VerifyRef Environment Configuration
# ====================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  SECURITY WARNING: Never commit your .env file to version control!
#     Add .env to your .gitignore file.

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# CrossRef API requires an email for polite pool access (higher rate limits)
CROSSREF_EMAIL=your-email@example.com

# =============================================================================
# OPTIONAL: AI-POWERED VERIFICATION
# =============================================================================

# OpenAI API Key for AI-powered fraud detection
# Get your key from: https://platform.openai.com/api-keys
# Leave empty to disable AI verification (tool still works without it)
OPENAI_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary database selection - OpenAlex recommended for speed and coverage
ENABLED_DATABASES=openalex,semantic_scholar,dblp,iacr,arxiv,pubmed
PRIMARY_DATABASE=openalex

# OpenAlex Configuration (Recommended - fast, free, comprehensive)
OPENALEX_ENABLED=true
OPENALEX_EMAIL=your.email@domain.com  # Optional - polite identifier

# Semantic Scholar API Key (recommended for higher rate limits)
# Get it from: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT=30
SEMANTIC_SCHOLAR_MAX_RETRIES=3
SEMANTIC_SCHOLAR_RATE_LIMIT=1.0

# CrossRef Configuration
CROSSREF_ENABLED=true

# DBLP Configuration
DBLP_ENABLED=true

# IACR Configuration  
IACR_ENABLED=true

# ArXiv Configuration
ARXIV_ENABLED=true

# PubMed Configuration
PUBMED_ENABLED=true
NCBI_API_KEY=  # Optional but recommended for higher rate limits
NCBI_EMAIL=your.email@domain.com

# Springer Nature API Key (optional)
# Get it from: https://dev.springernature.com/
SPRINGER_API_KEY=

# =============================================================================
# GROBID CONFIGURATION
# =============================================================================

# GROBID server URL (default for Docker setup)
GROBID_URL=http://localhost:8070

# =============================================================================
# CLASSIFICATION THRESHOLDS
# =============================================================================

SIMILARITY_THRESHOLD=0.55
TITLE_WEIGHT=0.60
AUTHOR_WEIGHT=0.20
VENUE_WEIGHT=0.15
YEAR_WEIGHT=0.05
MAX_YEAR_DIFFERENCE=3

